# ---------- 基础 ----------
GRAGRAG_ENV=dev
DATA_DIR=./data
DEFAULT_TENANT=default

# ---------- LLM / Embedding（留空则自动降级为离线确定性实现） ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
EMBEDDING_BACKEND=auto          # auto | hashing | openai | sentence-transformers
EMBEDDING_DIM=256               # hashing 模式生效
ST_MODEL=BAAI/bge-m3            # sentence-transformers 模式生效

# ---------- 存储 ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=graphrag_chunks
ES_URL=http://localhost:9200
ES_INDEX=graphrag_chunks
ES_API_KEY=

# ---------- 检索参数 ----------
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_GRAPH=20
RRF_K=60
RERANK_TOP_N=8
RERANKER_BACKEND=auto           # auto | heuristic | cross-encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 切片 ----------
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_SENTENCES=1

# ---------- Self-RAG ----------
ADAPTIVE_RETRIEVAL=true
ENABLE_HYDE=true
MAX_REFLECTION_LOOPS=2
IS_REL_THRESHOLD=0.22
IS_SUP_THRESHOLD=0.72
IS_USE_THRESHOLD=0.60

# ---------- 任务 ----------
MAX_INGEST_WORKERS=4
JOB_BACKEND=thread              # thread | celery
REDIS_URL=redis://localhost:6379/0
